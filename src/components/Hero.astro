---
// Hero.astro - Hero Section de Alta Gama con Animaciones GSAP en Cascada e Identidad Navy & Gold
---

<section id="inicio" class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32 bg-gradient-to-b from-white via-slate-50 to-slate-100">
  
  <!-- Halos sutiles de fondo en Oro Noble y Azul Marino Zafiro -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-32 left-1/4 w-[500px] h-[500px] bg-amber-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-24 w-[450px] h-[450px] bg-blue-900/5 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Columna Izquierda: Mensaje Central y Conversión (7 columnas) -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Badge Translúcido Dorado -->
        <div class="hero-badge inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-amber-50 border border-amber-200/80 text-amber-900 text-xs sm:text-sm font-bold mb-6 tracking-wide shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
          Innovación Contable y Certeza Tributaria
        </div>

        <!-- Título Principal con Énfasis Gradiente Oro -->
        <h1 class="hero-title text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6">
          “La contabilidad es el arte de <span class="bg-gradient-to-r from-amber-600 via-yellow-600 to-amber-700 bg-clip-text text-transparent">organizar la confusión</span>.”
        </h1>

        <!-- Subtítulo Ejecutivo -->
        <p class="hero-subtitle text-base sm:text-xl text-slate-600 font-normal leading-relaxed mb-10 max-w-2xl">
          Soluciones contables, fiscales y financieras con un enfoque estratégico, innovador y tecnológico para personas físicas, morales y profesionistas que buscan tranquilidad patrimonial.
        </p>

        <!-- Botones de Acción con Sombra Dorada -->
        <div class="hero-cta-group flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-12">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-extrabold text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-600 shadow-xl shadow-amber-500/25 hover:shadow-2xl hover:shadow-amber-500/35 active:scale-[0.98] transition-all duration-200 min-h-[50px] border border-amber-300/40 group cursor-pointer"
          >
            Agenda tu asesoría
            <svg class="ml-2.5 w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-800 bg-white hover:bg-slate-50 border border-slate-300 shadow-xs hover:shadow transition-all duration-200 min-h-[50px] cursor-pointer"
          >
            Explorar Catálogo y Tarifas
          </a>
        </div>

        <!-- Métricas de Respaldo -->
        <div class="hero-metrics pt-8 border-t border-slate-200 grid grid-cols-3 gap-4">
          <div class="hero-metric-item">
            <div class="text-2xl sm:text-3xl font-black text-slate-900">100%</div>
            <div class="text-xs sm:text-sm font-semibold text-slate-500 mt-0.5">Alineación SAT</div>
          </div>
          <div class="hero-metric-item">
            <div class="text-2xl sm:text-3xl font-black text-slate-900">&lt; 24h</div>
            <div class="text-xs sm:text-sm font-semibold text-slate-500 mt-0.5">Respuesta Ágil</div>
          </div>
          <div class="hero-metric-item">
            <div class="text-2xl sm:text-3xl font-black text-slate-900">+5 Años</div>
            <div class="text-xs sm:text-sm font-semibold text-slate-500 mt-0.5">Regularización</div>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Micro-Dashboard Abstracto en CSS/SVG (5 columnas) -->
      <div class="hero-dashboard-card lg:col-span-5 relative">
        
        <div class="relative rounded-3xl p-6 sm:p-8 bg-white border border-slate-200 shadow-2xl shadow-slate-900/10 transition-all duration-300 hover:border-amber-500/40">
          
          <!-- Header de Estado Tributario -->
          <div class="flex items-center justify-between pb-5 border-b border-slate-100">
            <div class="flex items-center gap-3.5">
              <div class="w-11 h-11 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center font-black text-sm">
                SAT
              </div>
              <div>
                <span class="block text-xs uppercase font-extrabold tracking-wider text-slate-400">Estatus Tributario</span>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-sm font-extrabold text-slate-900">Opinión 32-D: POSITIVA</span>
                </div>
              </div>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">
              Al Día
            </span>
          </div>

          <!-- Métrica Destacada: Saldo a Favor -->
          <div class="mt-6 p-4 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-bold text-slate-500">Saldo a Favor Proyectado</span>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-800 bg-amber-100 px-2 py-0.5 rounded">
                Declaración Anual
              </span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
              $18,450<span class="text-base font-bold text-emerald-600">.00 MXN</span>
            </div>
            <div class="mt-2 flex items-center gap-2 text-xs font-medium text-slate-500">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              <span>+30% optimizado mediante deducciones legítimas</span>
            </div>
          </div>

          <!-- Gráfico de Eficiencia en Barras CSS -->
          <div class="mt-6">
            <div class="flex items-center justify-between text-xs font-extrabold text-slate-700 mb-3">
              <span>Flujo de Optimización Fiscal</span>
              <span class="text-amber-600">Eficiencia 98.4%</span>
            </div>
            
            <div class="grid grid-cols-6 gap-2.5 items-end h-28 pt-2 px-2 rounded-xl bg-slate-50/80 border border-slate-100">
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-slate-200 rounded-t-md h-[40%]"></div>
                <span class="text-[10px] font-bold text-slate-400">Ene</span>
              </div>
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-slate-200 rounded-t-md h-[55%]"></div>
                <span class="text-[10px] font-bold text-slate-400">Feb</span>
              </div>
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-slate-200 rounded-t-md h-[70%]"></div>
                <span class="text-[10px] font-bold text-slate-400">Mar</span>
              </div>
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-slate-200 rounded-t-md h-[65%]"></div>
                <span class="text-[10px] font-bold text-slate-400">Abr</span>
              </div>
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-amber-400 rounded-t-md h-[85%]"></div>
                <span class="text-[10px] font-bold text-slate-500">May</span>
              </div>
              <div class="flex flex-col items-center gap-1.5 h-full justify-end">
                <div class="w-full bg-amber-500 rounded-t-md h-[95%] shadow-md shadow-amber-500/30"></div>
                <span class="text-[10px] font-black text-amber-700">Jun</span>
              </div>
            </div>
          </div>

          <!-- Micro-Card Conciliación CFDI con SVG Limpio -->
          <div class="mt-5 p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-900">Conciliación CFDI 4.0</div>
                <div class="text-[10px] text-slate-500">Nómina, ingresos y egresos al día</div>
              </div>
            </div>
            <span class="text-xs font-black text-emerald-600">100% OK</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<!-- Animación GSAP Hero al Cargar la Página -->
<script is:inline>
  const runHeroAnimation = () => {
    // @ts-ignore
    if (typeof gsap !== 'undefined') {
      // @ts-ignore
      const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.8 } });
      tl.from('.hero-badge', { y: -20, opacity: 0, duration: 0.6 })
        .from('.hero-title', { y: 25, opacity: 0, duration: 0.7 }, '-=0.3')
        .from('.hero-subtitle', { y: 20, opacity: 0, duration: 0.6 }, '-=0.3')
        .from('.hero-cta-group', { y: 15, opacity: 0, duration: 0.5 }, '-=0.3')
        .from('.hero-metric-item', { y: 15, opacity: 0, stagger: 0.1, duration: 0.4 }, '-=0.3')
        .from('.hero-dashboard-card', { x: 30, opacity: 0, duration: 0.8 }, '-=0.6');
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runHeroAnimation);
  } else {
    runHeroAnimation();
  }
</script>
