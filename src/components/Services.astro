---
// Services.astro - Bento Grid de Servicios de Alta Gama con Precios Oficiales y Animación GSAP ScrollTrigger

import { services } from '../data/services';
---

<section id="servicios" class="py-20 md:py-32 bg-slate-50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="max-w-3xl mx-auto text-center mb-16 sm:mb-20">
      <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200">
        Planes y Tarifas Oficiales
      </span>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mt-4 mb-5 leading-tight">
        Servicios Contables y Fiscales con Precios Transparentes
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Sin cargos ocultos ni sorpresas. Planes estructurados con la metodología de un despacho moderno para cada etapa de tu actividad.
      </p>
    </div>

    <!-- Bento Grid (Elementos 100% visibles por defecto en HTML) -->
    <div id="servicios-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-7">
      {services.map((service) => (
        <article
          class={`gsap-card relative rounded-3xl bg-white border min-w-0 p-6 sm:p-7 xl:p-8 flex flex-col justify-between transition-shadow duration-300 hover:shadow-2xl group ${
            service.highlight
              ? `${service.accentBorder}`
              : `border-slate-200 ${service.accentBorder}`
          }`}
        >
          {service.highlight && (
            <div class="absolute -top-3.5 right-6 px-3.5 py-1 rounded-full bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-md">
              Recomendado
            </div>
          )}

          <div>
            <!-- Header de la Tarjeta: Badge y Título -->
            <div class="flex items-center justify-between mb-4">
              <span class="inline-block max-w-full text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-lg bg-amber-50 text-amber-800 border border-amber-200/80">
                {service.badge}
              </span>
            </div>

            <h3 class="text-xl xl:text-2xl text-balance font-black text-slate-900 mb-2 group-hover:text-amber-700 transition-colors">
              {service.title}
            </h3>

            <!-- Precio Destacado -->
            <div class="my-4 pb-4 border-b border-slate-100">
              <div class="flex flex-col items-start gap-1.5 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-2">
                <span class="max-w-full text-2xl xl:text-3xl font-extrabold text-slate-900 tracking-tight">
                  {service.price}
                </span>
                <span class="text-sm font-semibold text-slate-500">
                  {service.period}
                </span>
              </div>
            </div>

            <!-- Descripción -->
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- Lista de Características con Checkmarks SVG Limpios -->
            <ul class="space-y-3 mb-8" aria-label={`Conceptos de ${service.title}`}>
              {service.features.map((feature) => (
                <li class="flex items-start text-sm text-slate-700 leading-relaxed">
                  <span class="mr-3 mt-0.5 text-amber-700 flex-shrink-0" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Botón de Acción -->
          <div class="pt-4 border-t border-slate-100">
            <a
              href="#contacto"
              data-service-id={service.id}
              class={`w-full inline-flex items-center justify-center py-3.5 px-4 rounded-xl text-sm font-bold transition-all duration-200 cursor-pointer ${
                service.highlight
                  ? "bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-600 text-slate-950 shadow-md shadow-amber-500/25 hover:shadow-lg"
                  : "bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 group-hover:border-amber-400"
              }`}
            >
              Solicitar este servicio
              <svg class="w-4 h-4 shrink-0 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
