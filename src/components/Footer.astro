---
// Footer.astro - Sección de Contacto con Formulario Luminoso y Pie Azul Marino Institucional
import ContactForm from './ContactForm.astro';
---

<footer id="contacto" class="bg-slate-900 text-slate-300 pt-20 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Bloque Superior: Información de Contacto y Formulario Luminoso -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-20 border-b border-slate-800">
      
      <!-- Columna Informativa de Contacto (5 columnas) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <!-- Badge Dorado -->
          <span class="inline-flex items-center text-xs sm:text-sm font-extrabold uppercase tracking-wider text-amber-400 bg-amber-950/60 px-3.5 py-1.5 rounded-full border border-amber-500/40">
            Hablemos de tus Números
          </span>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mt-5 mb-6 leading-tight">
            ¿Listo para llevar tu salud fiscal al siguiente nivel?
          </h2>

          <p class="text-base text-slate-300 leading-relaxed mb-10">
            Agenda una sesión diagnóstica con nuestro equipo en <strong class="text-white">CONTADORES SA S.C.</strong> Analizamos tu situación tributaria particular para ofrecerte una solución ágil, legal y rentable.
          </p>

          <!-- Canales de Contacto Directo -->
          <div class="space-y-5">
            
            <!-- Teléfono Directo -->
            <a
              href="tel:5615492707"
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-800/80 border border-slate-700 hover:border-amber-400 hover:bg-slate-800 transition-all duration-200 group"
            >
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center flex-shrink-0 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs uppercase font-extrabold tracking-wider text-slate-400">Atención Telefónica Directa</span>
                <span class="text-base sm:text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                  (56) 1549-2707
                </span>
              </div>
            </a>

            <!-- Correo Electrónico -->
            <a
              href="mailto:novagestion@gmail.com"
              class="flex items-center gap-4 p-4 rounded-2xl bg-slate-800/80 border border-slate-700 hover:border-amber-400 hover:bg-slate-800 transition-all duration-200 group"
            >
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center flex-shrink-0 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="block text-xs uppercase font-extrabold tracking-wider text-slate-400">Correo Electrónico Oficial</span>
                <span class="text-base sm:text-lg font-bold text-white group-hover:text-amber-400 transition-colors break-all">
                  novagestion@gmail.com
                </span>
              </div>
            </a>

          </div>
        </div>

        <!-- Garantía y Confidencialidad con SVG Estándar Heroicons -->
        <div class="mt-8 pt-6 border-t border-slate-800 flex items-center gap-3 text-xs text-slate-400">
          <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <span>Tratamiento de información bajo riguroso secreto profesional y confidencialidad fiscal.</span>
        </div>
      </div>

      <!-- Columna Formulario: Tarjeta Luminosa Blanca y 100% Legible (7 columnas) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 shadow-2xl border border-slate-200">
        <div class="mb-8">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Solicita tu Asesoría Fiscal
          </h3>
          <p class="text-sm text-slate-600 mt-2">
            Completa el siguiente formulario y un contador especialista te responderá en menos de 24 horas hábiles.
          </p>
        </div>

        <!-- Componente Semántico Luminoso -->
        <div id="contact-form-container">
          <ContactForm />
        </div>
      </div>

    </div>

    <!-- Bloque Inferior: Derechos, Logo y Enlaces Rápidos -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-400">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="Logo CONTADORES SA S.C." class="w-8 h-8 object-contain rounded-md" />
        <span class="font-bold text-white">CONTADORES SA S.C.</span>
        <span>— © {new Date().getFullYear()} Todos los derechos reservados.</span>
      </div>

      <nav class="flex items-center gap-7 font-medium" aria-label="Enlaces rápidos de pie">
        <a href="#inicio" class="hover:text-amber-400 transition-colors">Inicio</a>
        <a href="#nosotros" class="hover:text-amber-400 transition-colors">Nosotros</a>
        <a href="#servicios" class="hover:text-amber-400 transition-colors">Servicios y Tarifas</a>
        <a href="#contacto" class="hover:text-amber-400 transition-colors">Contacto</a>
      </nav>
    </div>

  </div>
</footer>
